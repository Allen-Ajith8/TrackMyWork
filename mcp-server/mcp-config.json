{
  "name": "TrackMyWork MCP Server",
  "version": "1.0.0",
  "description": "Vibe Coding Telemetry for TrackMyWork hackathon management",
  "servers": {
    "trackmywork": {
      "command": "node",
      "args": ["dist/index.js"],
      "cwd": "${workspaceFolder}/mcp-server",
      "env": {
        "SUPABASE_URL": "${env:NEXT_PUBLIC_SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${env:SUPABASE_SERVICE_ROLE_KEY}",
        "NVIDIA_NIM_API_KEY": "${env:NVIDIA_NIM_API_KEY}",
        "NVIDIA_NIM_BASE_URL": "${env:NVIDIA_NIM_BASE_URL}",
        "NIM_MODEL_DEEPSEEK_R1": "${env:NIM_MODEL_DEEPSEEK_R1}",
        "MCP_HTTP_PORT": "3002",
        "MCP_WS_PORT": "3003"
      }
    }
  },
  "tools": [
    "trackmywork_heartbeat",
    "trackmywork_pull_env",
    "trackmywork_status",
    "trackmywork_get_context",
    "trackmywork_create_task",
    "trackmywork_sos_debug"
  ],
  "resources": [
    "trackmywork://room/{room_id}/context",
    "trackmywork://user/{user_id}/permissions/{room_id}",
    "trackmywork://room/{room_id}/env"
  ]
}