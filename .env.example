# ============================================================================
# TrackMyWork - Environment Variables
# ============================================================================
# Copy this to .env.local and fill in your values
# Never commit .env.local to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (Required)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
# Google OAuth - Configure in Supabase Dashboard > Authentication > Providers
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# NVIDIA NIM API (Required for AI features)
# ----------------------------------------------------------------------------
NVIDIA_NIM_API_KEY=your-nim-api-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model IDs (adjust based on availability)
NIM_MODEL_LLAMA_3_3_70B=meta/llama-3.3-70b-instruct
NIM_MODEL_DEEPSEEK_R1=deepseek-ai/deepseek-r1
NIM_MODEL_QWEN_CODER=qwen/qwen2.5-coder-32b-instruct

# ----------------------------------------------------------------------------
# GitHub Integration (GitHub App)
# ----------------------------------------------------------------------------
# Create a GitHub App: https://github.com/settings/apps/new
# - Setup URL:      {APP_URL}/api/github/callback
# - Webhook URL:    {APP_URL}/api/webhooks/github
# - Webhook secret: same value as GITHUB_WEBHOOK_SECRET
# - Repository permissions: Contents (read), Metadata (read), Issues (read),
#   Pull requests (read)
# - Subscribe to events: push, pull_request, issues, workflow_run
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# The URL slug of the app (the part after github.com/apps/).
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Signs the GitHub connection state. Falls back to GITHUB_WEBHOOK_SECRET.
GITHUB_STATE_SECRET=your-random-state-secret
# OAuth client credentials (optional; only used by the user OAuth flow).
GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret

# ----------------------------------------------------------------------------
# Upstash QStash (Background Jobs)
# ----------------------------------------------------------------------------
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key
# Cron endpoint URL (Vercel deployment URL + /api/cron)
QSTASH_URL=https://your-app.vercel.app/api/cron

# ----------------------------------------------------------------------------
# Firebase Cloud Messaging (Push Notifications)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# Firebase Admin (for server-side FCM)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ----------------------------------------------------------------------------
# Discord Integration
# ----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_PUBLIC_KEY=your-public-key
DISCORD_WEBHOOK_URL=your-default-webhook-url

# ----------------------------------------------------------------------------
# Canva Integration
# ----------------------------------------------------------------------------
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
CANVA_REDIRECT_URI=http://localhost:3000/api/auth/canva/callback

# ----------------------------------------------------------------------------
# Google Sheets (Hackathon Tracker)
# ----------------------------------------------------------------------------
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
HACKATHON_TRACKER_SHEET_ID=your-spreadsheet-id

# ----------------------------------------------------------------------------
# MCP Server (Separate Process)
# ----------------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:3001
MCP_SERVER_PORT=3001

# ----------------------------------------------------------------------------
# Nexconn Chat (per-room Team Chat)
# ----------------------------------------------------------------------------
# App Key / App Secret / data center: https://console.nexconn.ai/agile/apps/km
# NEXCONN_APP_SECRET is server-only and must never be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_NEXCONN_APP_KEY=your-nexconn-app-key
NEXCONN_APP_SECRET=your-nexconn-app-secret
# Data center code: BJ | SG | NA | SA | OM
NEXT_PUBLIC_NEXCONN_AREA_CODE=SG
# Must match the data center selected for the app
NEXCONN_API_BASE_URL=https://api.sg-light-api.com

# ----------------------------------------------------------------------------
# App Configuration
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=TrackMyWork
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Feature Flags
ENABLE_NIM_AUTOMATION=true
ENABLE_VIBE_TELEMETRY=true
ENABLE_GHOST_MODE=true
ENABLE_HARDWARE_BOM=true